
void main(){
  var list = ['shohan', 10, true, 25, false];
  List<int> number = [];
  List<bool> boolen = [];
  
  for(int i = 0; i<list.length; i++){
    if(list[i] is int){
      number.add(list[i] as int);
    }
    if(list[i] is bool){
      boolen.add(list[i] as bool);
    }
    
  }
  print(number);
  print(boolen);
}
