// 👉 একটি bool list:

// [true, false, true, true]

// 👉 কয়টা true আছে count করো

void main(){
  List<bool> list = [true,false,false,true,true,true,false,true,false,false];
  
  int count = 0;
  
  for(int i = 0; i < list.length; i++){
    if(list[i] == true){
      count++;
    }
  }
  print('true is there for : $count times');
}
